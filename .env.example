# STEP-SAFE Environment Configuration Template
# Copy this file to .env and adjust values as needed.

# Flask Application & Security
STEP_SAFE_SECRET_KEY=change-this-to-a-secure-random-string-in-production
STEP_SAFE_DB=step_safe.db
# Set to 1 if deploying over HTTPS to enforce secure cookies
STEP_SAFE_HTTPS=0

# Development / Demonstration
# Set to 1 to seed initial demo accounts (admin, caregiver, patient)
STEP_SAFE_SEED_DEMO=0

# Firebase Cloud Messaging (FCM HTTP v1) - Optional
# Set the path to your Google Service Account JSON file for mobile push
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
FIREBASE_PROJECT_ID=your-firebase-project-id
# Alternatively, inline service account JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
